msgstr "Estilización"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:200
msgid "Typography"
msgstr "Tipografía"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:208
msgid "Text content"
msgstr "Lírica"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:216
msgid "Button opening the consent banner"
msgstr "Botón que abre el banner de consentimiento"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:273
#: admin/modules/cook/customizer/fupi-customizer-settings.php:298
msgid "Position"
msgstr "Posición"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:277
msgid "Center (recommended)"
msgstr "Centrado (recomendado)"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:278
#: admin/modules/cook/customizer/fupi-customizer-settings.php:302
msgid "Bottom - Narrow"
msgstr "Abajo - estrecho"

#: admin/modules/cook/customizer/fupi-customizer-settings.php:279
#: admin/modules/cook/customizer/fupi-customizer-settings.php:303
