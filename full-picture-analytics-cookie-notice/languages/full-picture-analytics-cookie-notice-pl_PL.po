#: admin/modules/cook/cook-descr.php:13
msgid "Frequently asked questions"
msgstr "Często zadawane pytania"

#: admin/modules/cook/cook-descr.php:19
msgid "Keep proofs of your visitors' consents. This is required by GDPR, protects against potential fines, enables audit trails and helps demonstrate responsible data handling practices."
msgstr "Zachowaj dowody zgody odwiedzających. Jest to wymagane przez GDPR, chroni przed potencjalnymi grzywnami, umożliwia przeprowadzenie audytu i pomaga w zademonstrowaniu odpowiedzialnych metod przetwarzania danych."

#: admin/modules/cook/cook-descr.php:30
#, php-format
msgid "YouTube videos, Google maps, social embeds and other content loaded from other platforms %3$scan track your visitors%4$s. Settings on this page let you replace them with placeholders and load them after visitors agree to tracking. %1$sSee examples%2$s."
msgstr "Filmy YouTube, mapy Google, osadzone treści z sieci społecznościowych i inne treści wczytane z innych platform %3$smogą śledzić odwiedzających%4$s. Ustawienia na tej stronie pozwalają zastąpić je elementami tymczasowymi i załadować kiedy odwiedzający wyrażą zgodę na śledzenie. %1$sZobacz przykłady%2$s."

#: admin/modules/cook/cook-descr.php:31
#, php-format
msgid "Attention. To use placeholders with unique background images or block content loaded dynamically (after the page loads), you should use %1$sthe shortcode method or the HTML method%2$s"
msgstr "Uwaga. Żeby używać elementów zastępczych z unikalnymi obrazami tła lub treścią blokową ładowaną dynamicznie (po załadowaniu strony), powinieneś skorzystać z %1$sshortcodów albo specjalnego HTML%2$s"

#: admin/modules/cook/cook-descr.php:37
#, php-format
msgid "Other plugins can %3$strack your visitors%4$s. Use settings on this page to block them or their tracking scripts and load them only after visitors agree to tracking. %1$sSee examples%2$s."
msgstr "Inne wtyczki mogą %3$sśledzić Twoich odwiedzających%4$s. Użyj ustawień na tej stronie, aby zablokować je lub ich skrypty śledzące i załadować je dopiero gdy odwiedzający wyrażą zgodę na śledzenie. %1$sZobacz przykłady%2$s."

#: admin/modules/cook/cook-descr.php:39
#, php-format
