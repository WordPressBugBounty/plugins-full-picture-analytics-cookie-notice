msgstr "zakup (jako wewnętrzne i oddzielne zdarzenie)"

#: admin/modules/mato/mato-descr.php:66
#, php-format
msgid "product view %1$s(only as an internal Matomo event!)%2$s"
msgstr "wyświetlenie strony produktu %1$s(tylko jako wewnętrzne zdarzenie Matomo!)%2$s"

#: admin/modules/mato/mato-descr.php:67
msgid "add to cart (as an internal and separate event)"
msgstr "dodanie produktu do koszyka (jako wewnętrzne i oddzielne zdarzenie)"

#: admin/modules/mato/mato-descr.php:68
